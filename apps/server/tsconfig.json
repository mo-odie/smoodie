{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "../..",
    "isolatedModules": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "declaration": true,
    "noEmit": false,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@smoodie/provider": ["../../packages/provider/provider"],
      "@smoodie/server/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "../../packages/provider/**/*"],
  "exclude": ["node_modules"]
} 